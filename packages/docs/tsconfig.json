{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "paths": {
      "@exre/exui": ["./node_modules/@exre/exui"],
      "react": ["./node_modules/@types/react"],
      "react/*": ["./node_modules/@types/react/*"]
    },
    "types": ["vite/client", "node"],
    "rootDirs": [".", "./.react-router/types"],
    "resolveJsonModule": true,
    "allowArbitraryExtensions": true,
    "jsx": "react-jsx",
    "noEmit": true
  },
  "include": ["tests", "src", "app", "lib", "source.config.ts", ".source", ".react-router/types/**/*"]
}
