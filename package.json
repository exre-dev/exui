{
  "name": "@exre/exui-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "pnpm --filter @exre/exui-tokens build && pnpm --filter @exre/exui build && pnpm --filter @exre/exui-docs dev",
    "watch": "node scripts/watch.mjs",
    "build": "pnpm --filter @exre/exui-tokens build && pnpm --filter @exre/exui build && pnpm --filter @exre/exui-docs build",
    "typecheck": "pnpm --filter @exre/exui-tokens typecheck && pnpm --filter @exre/exui typecheck && pnpm --filter @exre/exui build:types && pnpm --filter @exre/exui-docs typecheck",
    "lint": "oxlint scripts && pnpm --filter @exre/exui-tokens lint && pnpm --filter @exre/exui lint && pnpm --filter @exre/exui-docs lint",
    "test:visual": "pnpm --filter @exre/exui-docs test:visual",
    "test:regressions": "node --test scripts/chart-style.test.mjs scripts/run-command.test.mjs scripts/watch.test.mjs packages/components/scripts/rem.test.mjs",
    "upstream:restore": "node scripts/reui-restore.mjs",
    "upstream:check": "node scripts/reui-sync.mjs --check && node scripts/reui-exports.mjs --check && node scripts/reui-foundation-diff.mjs --check && node scripts/generate-reui-luma.mjs --check",
    "test:upstream": "node --test scripts/reui-restore.test.mjs scripts/reui-sync.test.mjs scripts/reui-exports.test.mjs scripts/reui-luma.test.mjs packages/components/scripts/module-specifiers.test.mjs",
    "tokens:check": "pnpm --filter @exre/exui-tokens tokens:check",
    "verify:pack": "node scripts/verify-packages.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "test:release": "node --test scripts/release-bootstrap/*.test.mjs",
    "release:verify": "node scripts/release-bootstrap/verify.mjs --root .",
    "docs:examples:lock": "node scripts/docs-examples.mjs lock",
    "docs:examples:restore": "node scripts/docs-examples.mjs restore",
    "docs:examples:generate": "node scripts/docs-examples.mjs generate",
    "docs:examples:check": "node scripts/docs-examples.mjs check",
    "docs:examples:report": "node scripts/docs-examples.mjs report",
    "test:docs-examples": "node --test scripts/docs-examples.test.mjs",
    "test:docs-sharing": "node --test scripts/docs-sharing.test.mjs",
    "docs:sharing:verify": "node scripts/verify-docs-sharing.mjs",
    "test:docs-example-copy": "node --test scripts/docs-example-copy.test.mjs scripts/docs-example-copy-ssr.test.mjs",
    "docs:examples:styles:check": "node scripts/docs-example-styles.mjs",
    "test:docs-example-styles": "node --test scripts/docs-example-styles.test.mjs",
    "docs:examples:assets:check": "node scripts/docs-example-assets.mjs",
    "test:docs-example-assets": "node --test scripts/docs-example-assets.test.mjs",
    "docs:content:check": "node scripts/docs-content.mjs check",
    "docs:content:generate": "node scripts/docs-content.mjs generate",
    "docs:capabilities:generate": "node scripts/exui-capabilities.mjs --write",
    "docs:capabilities:check": "node scripts/exui-capabilities.mjs --check",
    "test:docs-capabilities": "node --test scripts/exui-capabilities.test.mjs scripts/docs-snippets.test.mjs scripts/exui-skill/sync-references.test.mjs",
    "test:docs-content": "node --test scripts/docs-content.test.mjs scripts/docs-static.test.mjs scripts/docs-example-base.test.mjs scripts/docs-dev-sources.test.mjs",
    "docs:snippets:verify": "node scripts/docs-snippets.mjs",
    "docs:static:verify": "node scripts/verify-docs-static.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "oxlint": "^1.71.0"
  }
}
